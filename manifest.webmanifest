{
  "name": "Fahrplananzeige Führerraum",
  "short_name": "Fahrplan",
  "description": "Blattfahrplan und Tages-La aus der EBuLa-Rückfallebene anzeigen. Inoffiziell.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#dfe3de",
  "theme_color": "#273035",
  "icons": [
    { "src": "symbol/192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "symbol/512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "symbol/maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "geteilt",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titel",
      "text": "text",
      "url": "adresse",
      "files": [{ "name": "datei", "accept": ["application/pdf", ".pdf"] }]
    }
  },
  "file_handlers": [
    { "action": "./", "name": "Blattfahrplan", "accept": { "application/pdf": [".pdf"] } }
  ]
}
